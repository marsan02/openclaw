{
  "name": "marsan-apps",
  "version": "1.0.0",
  "description": "Marsan's App Marketplace - Quick deploy platform for app ideas",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "nodemon server/index.js",
    "dev:client": "cd apps/marketplace && npm run dev",
    "build": "cd apps/marketplace && npm run build",
    "start": "node server/index.js",
    "postinstall": "cd apps/marketplace && npm install"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.2"
  }
}
